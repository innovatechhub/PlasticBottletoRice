rules_version = '2';

// Roles:
//   admin    - Firebase Auth user with custom claim role == "admin" (set by scripts/admin-tools.js)
//   resident - Firebase Auth user whose uid has a document in /household
//   device   - ESP32 bin account (custom claim role == "device"); it only uses the Realtime Database
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    function isResident() {
      return signedIn()
        && exists(/databases/$(database)/documents/household/$(request.auth.uid));
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    match /household/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if isAdmin()
        && request.resource.data.role == 'user'
        && !('password' in request.resource.data);
      // Residents may only move their own balance counters.
      allow update: if signedIn()
        && request.auth.uid == uid
        && onlyChanges(['weightKg', 'recycledItemCount', 'totalRecycledWeightKg']);
      allow delete: if isAdmin();
    }

    match /transactions/{txId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin()
        || (isResident()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.type in ['bottle', 'redeem']
          && request.resource.data.status == 'completed');
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      function visibleToCaller() {
        return resource.data.userId == request.auth.uid
          || (resource.data.userId == null && resource.data.targetRole in ['all', 'user']);
      }

      allow read: if isAdmin() || (signedIn() && visibleToCaller());
      allow create: if isAdmin()
        || (isResident()
          && request.resource.data.readBy.size() == 0
          && (request.resource.data.userId == request.auth.uid
            || (request.resource.data.userId == null
              && request.resource.data.targetRole in ['admin', 'all'])));
      // Residents may only add their own uid to readBy.
      allow update: if isAdmin()
        || (isResident()
          && visibleToCaller()
          && onlyChanges(['readBy'])
          && request.resource.data.readBy.hasAll(resource.data.readBy)
          && request.resource.data.readBy.size() == resource.data.readBy.size() + 1
          && request.auth.uid in request.resource.data.readBy);
      allow delete: if isAdmin();
    }

    match /system/{docId} {
      allow read: if isAdmin() || isResident();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isResident()
          && docId == 'config'
          && onlyChanges(['riceStock', 'bottleStorage', 'totalItemsRecycled', 'totalWeightRecycledKg']));
    }
  }
}
